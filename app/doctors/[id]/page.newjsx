"use client";

import React from "react";
import Image from "next/image";
import { motion } from "framer-motion";
import { useParams } from "next/navigation";
import useSWR from "swr"; // Assuming you are using SWR
import  ApiService  from "./../../src/services/Apiservices"; // Adjust this import path based on your project structure
import {
  Award,
  BadgeCheck,
  BookOpen,
  BriefcaseMedical,
  CalendarDays,
  CheckCircle2,
  GraduationCap,
  Mail,
  Phone,
  ShieldCheck,
  Stethoscope,
} from "lucide-react";

/* =========================================================
   ANIMATION VARIANTS
========================================================= */

const fadeUp = {
  hidden: { opacity: 0, y: 25 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.65, ease: [0.22, 1, 0.36, 1] },
  },
};

const fadeLeft = {
  hidden: { opacity: 0, x: -30 },
  visible: {
    opacity: 1,
    x: 0,
    transition: { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
  },
};

const fadeRight = {
  hidden: { opacity: 0, x: 30 },
  visible: {
    opacity: 1,
    x: 0,
    transition: { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
  },
};

const staggerContainer = {
  hidden: {},
  visible: { transition: { staggerChildren: 0.1 } },
};

/* =========================================================
   CARD COMPONENT
========================================================= */

const Card = ({ children, className = "", glowColor = "bg-[#063B5C]/10" }) => {
  return (
    <motion.div
      variants={fadeUp}
      whileHover={{ y: -4 }}
      transition={{ duration: 0.25 }}
      className={`
        group relative overflow-hidden rounded-[28px] border border-slate-200/70
        bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,0.045)]
        transition-shadow duration-300 hover:shadow-[0_18px_45px_rgba(15,23,42,0.08)]
        sm:p-7 ${className}
      `}
    >
      <div
        className={`
          pointer-events-none absolute -right-16 -top-16 h-32 w-32 rounded-full
          ${glowColor} opacity-30 blur-3xl transition-all duration-500
          group-hover:scale-150 group-hover:opacity-50
        `}
      />
      <div className="relative z-10">{children}</div>
    </motion.div>
  );
};

/* =========================================================
   SECTION TITLE
========================================================= */

const SectionTitle = ({
  icon,
  title,
  iconBg = "bg-[#063B5C]/10",
  iconColor = "text-[#063B5C]",
}) => {
  return (
    <div className="flex items-center gap-3">
      <motion.div
        whileHover={{ scale: 1.08, rotate: 5 }}
        transition={{ duration: 0.2 }}
        className={`
          flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl
          ${iconBg} ${iconColor}
        `}
      >
        {icon}
      </motion.div>
      <div>
        <h2 className="text-xl font-bold tracking-tight text-slate-900">
          {title}
        </h2>
        <div className="mt-1.5 h-1 w-8 rounded-full bg-gradient-to-r from-[#063B5C] to-[#0A7891]" />
      </div>
    </div>
  );
};

/* =========================================================
   STAT CARD
========================================================= */

const StatCard = ({ icon, value, label, iconBg, iconColor, cardBg }) => {
  return (
    // <motion.div
    //   variants={fadeUp}
    //   whileHover={{ y: -5, scale: 1.015 }}
    //   transition={{ duration: 0.25 }}
    //   className={`
    //     group relative overflow-hidden rounded-[24px] border border-slate-200/70
    //     ${cardBg} p-5 shadow-[0_8px_25px_rgba(15,23,42,0.04)]
    //     transition-shadow duration-300 hover:shadow-[0_16px_35px_rgba(15,23,42,0.08)]
    //   `}
    // >
    //   <div
    //     className={`
    //       absolute -right-8 -top-8 h-24 w-24 rounded-full ${iconBg}
    //       opacity-40 blur-xl transition-transform duration-500 group-hover:scale-150
    //     `}
    //   />
    //   <div className="relative">
    //     <motion.div
    //       whileHover={{ rotate: 6, scale: 1.08 }}
    //       className={`
    //         flex h-11 w-11 items-center justify-center rounded-2xl
    //         ${iconBg} ${iconColor}
    //       `}
    //     >
    //       {icon}
    //     </motion.div>
    //     <div className="mt-4">
    //       <p className="text-2xl font-bold tracking-tight text-slate-900">
    //         {value}
    //       </p>
    //       <p className="mt-1 text-xs font-medium text-slate-500">{label}</p>
    //     </div>
    //   </div>
    // </motion.div>
    <motion.div
  variants={fadeUp}
  whileHover={{ y: -5, scale: 1.015 }}
  transition={{ duration: 0.25 }}
  className={`
    group relative overflow-hidden
    rounded-[22px]
    border border-slate-200/70
    ${cardBg}
    px-5 py-5
    shadow-[0_7px_22px_rgba(15,23,42,0.045)]
    transition-shadow duration-300
    hover:shadow-[0_14px_32px_rgba(15,23,42,0.08)]
  `}
>
  {/* Soft Glow */}
  <div
    className={`
      absolute -right-8 -top-8
      h-24 w-24
      rounded-full
      ${iconBg}
      opacity-40
      blur-xl
      transition-transform duration-500
      group-hover:scale-150
    `}
  />

  {/* Watermark Icon */}
  <div
    className="
      pointer-events-none
      absolute -bottom-7 -right-5
      text-slate-700
      opacity-[0.065]
      transition-all duration-500
      group-hover:scale-110
      group-hover:rotate-6
      group-hover:opacity-[0.10]
    "
  >
    <div className="h-28 w-28">
      {React.cloneElement(icon, {
        size: 112,
        strokeWidth: 1.15,
      })}
    </div>
  </div>

  {/* Content */}
  <div className="relative z-10 flex items-center gap-4">

    {/* Icon */}
    <motion.div
      whileHover={{ rotate: 6, scale: 1.08 }}
      transition={{ duration: 0.2 }}
      className={`
        flex h-12 w-12 shrink-0
        items-center justify-center
        rounded-2xl
        ${iconBg}
        ${iconColor}
      `}
    >
      {icon}
    </motion.div>

    {/* Text */}
    <div className="min-w-0">
      <p
        className="
          text-[23px]
          font-bold
          leading-none
          tracking-tight
          text-slate-900
        "
      >
        {value}
      </p>

      <p
        className="
          mt-1.5
          truncate
          text-xs
          font-medium
          text-slate-500
        "
      >
        {label}
      </p>
    </div>

  </div>
</motion.div>
  );
};

/* =========================================================
   PAGE
========================================================= */

const Page = () => {
  const params = useParams();
  const doctorId = Array.isArray(params?.id) ? params.id[0] : params?.id;

  /* =======================================================
     LIVE API
  ======================================================= */
  const { data, error, isLoading } = useSWR(
    doctorId ? `doctors/${doctorId}` : null,
    ApiService.get
  );

  const doctorData = data?.data || null;

  console.log(doctorData)

  

  // Handle Loading State
  if (isLoading) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-50">
        <div className="flex flex-col items-center gap-4">
          <div className="h-12 w-12 animate-spin rounded-full border-4 border-[#063B5C] border-t-transparent"></div>
          <p className="text-slate-600 font-medium">Loading Doctor Profile...</p>
        </div>
      </main>
    );
  }

  // Handle Error State
  if (error || !data) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-slate-50">
        <div className="rounded-2xl bg-white p-8 text-center shadow-lg border border-slate-200 max-w-md">
          <div className="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-100 text-red-600 mb-4">
            <ShieldCheck size={28} />
          </div>
          <h2 className="text-xl font-bold text-slate-800">Profile Not Found</h2>
          <p className="mt-2 text-slate-500">
            We couldn't load the doctor's information. Please try again later.
          </p>
        </div>
      </main>
    );
  }

  // Ensure arrays exist to prevent crashes
  const specializations = data?.web_specilization || [];
  const certifications = data?.web_certificat || [];
  const awards = data?.web_awards || [];

  return (
    <main className="min-h-screen bg-slate-50 py-8 md:py-12">
      <div className="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        {/* =================================================
            HERO
        ================================================= */}
        <motion.section
          initial="hidden"
          animate="visible"
          variants={fadeUp}
          className="
            relative overflow-hidden rounded-[30px] bg-white
            shadow-[0_12px_45px_rgba(15,23,42,0.07)] ring-1 ring-slate-200/70
          "
        >
          {/* Gradient Header */}
          <div className="absolute inset-x-0 top-0 h-[320px] overflow-hidden">
            <motion.div
              animate={{ backgroundPosition: ["0% 50%", "100% 50%", "0% 50%"] }}
              transition={{ duration: 12, repeat: Infinity, ease: "linear" }}
              className="
                absolute inset-0 bg-[length:200%_200%] bg-gradient-to-r
                from-[#063B5C] via-[#075579] to-[#0A7891]
              "
              style={{ clipPath: "polygon(0 0, 100% 0, 100% 3%, 0 100%)" }}
            />
            <motion.div
              animate={{ opacity: [0.15, 0.3, 0.15], scale: [1, 1.12, 1] }}
              transition={{ duration: 5, repeat: Infinity, ease: "easeInOut" }}
              className="
                absolute right-[10%] top-[-80px] h-72 w-72 rounded-full
                bg-white/20 blur-3xl
              "
            />
            <motion.div
              animate={{ y: [0, 15, 0], x: [0, -10, 0], opacity: [0.1, 0.25, 0.1] }}
              transition={{ duration: 6, repeat: Infinity, ease: "easeInOut" }}
              className="
                absolute right-[22%] top-8 h-28 w-28 rounded-full
                border border-white/20
              "
            />
          </div>

          {/* Hero Content */}
          <div className="relative px-5 pb-9 pt-20 sm:px-8 sm:pt-24 lg:px-12">
            <div className="flex flex-col gap-7 md:flex-row md:items-end">
              
              {/* DOCTOR IMAGE */}
              <motion.div
                initial={{ opacity: 0, scale: 0.8, y: 25 }}
                animate={{ opacity: 1, scale: 1, y: 0 }}
                transition={{ duration: 0.7, delay: 0.15, ease: [0.22, 1, 0.36, 1] }}
                className="relative shrink-0"
              >
                <motion.div
                  whileHover={{ scale: 1.025 }}
                  transition={{ duration: 0.3 }}
                  className="
                    h-36 w-36 overflow-hidden rounded-[28px] border-[6px]
                    border-white bg-slate-100 shadow-2xl sm:h-44 sm:w-44 md:h-48 md:w-48
                  "
                >
                  <Image
                    src={doctorData.image_url || "https://images.pexels.com/photos/5452293/pexels-photo-5452293.jpeg"}
                    alt={doctorData.name || "Doctor"}
                    width={192}
                    height={192}
                    priority
                    className="h-full w-full object-cover"
                  />
                </motion.div>

                {/* Verified Badge */}
                <motion.div
                  initial={{ scale: 0, rotate: -45 }}
                  animate={{ scale: 1, rotate: 0 }}
                  transition={{ delay: 0.8, duration: 0.45, type: "spring", stiffness: 220 }}
                  className="
                    absolute -bottom-3 -right-3 flex h-11 w-11 items-center justify-center
                    rounded-full bg-emerald-500 text-white shadow-lg ring-4 ring-white
                  "
                >
                  <BadgeCheck size={23} />
                </motion.div>
              </motion.div>

              {/* BASIC INFORMATION */}
              <motion.div variants={fadeLeft} className="flex-1 pb-1">
                <div className="mb-3 flex flex-wrap items-center gap-2">
                  <motion.span
                    whileHover={{ scale: 1.03 }}
                    className="
                      rounded-full bg-[#063B5C]/10 px-3.5 py-1.5 text-xs
                      font-bold text-[#063B5C] backdrop-blur-sm
                    "
                  >
                    {data.web_heading || "Specialist"}
                  </motion.span>
                  <motion.span
                    whileHover={{ scale: 1.03 }}
                    className="
                      flex items-center gap-1.5 rounded-full bg-emerald-50 px-3.5
                      py-1.5 text-xs font-bold text-emerald-700
                    "
                  >
                    <span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                    Available
                  </motion.span>
                </div>

                <h1 className="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
                  {doctorData.name}
                </h1>
                <p className="mt-2 text-lg font-semibold text-[#075579]">
                  {doctorData.web_heading}
                </p>

                <div className="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-sm text-slate-600">
                  <div className="flex items-center gap-2">
                    <GraduationCap size={18} className="text-[#075579]" />
                    {doctorData.qualification}
                  </div>
                  <div className="flex items-center gap-2">
                    <BriefcaseMedical size={18} className="text-[#075579]" />
                    {doctorData.experience_years}+ Years Experience
                  </div>
                </div>
              </motion.div>

              {/* CONTACT BUTTONS */}
              <motion.div variants={fadeRight} className="flex shrink-0 flex-col gap-3 md:pb-1">
                <motion.a
                  whileHover={{ y: -2, scale: 1.02 }}
                  whileTap={{ scale: 0.98 }}
                  href={`tel:${data.contact_no}`}
                  className="
                    flex items-center justify-center gap-2 rounded-xl bg-[#063B5C]
                    px-5 py-3 text-sm font-semibold text-white shadow-lg
                    shadow-[#063B5C]/20 transition-colors duration-300 hover:bg-[#052f49]
                  "
                >
                  <Phone size={17} />
                  Contact Doctor
                </motion.a>
                <motion.a
                  whileHover={{ y: -2, scale: 1.02 }}
                  whileTap={{ scale: 0.98 }}
                  href={`mailto:${data.email}`}
                  className="
                    flex items-center justify-center gap-2 rounded-xl border border-slate-200
                    bg-white/90 px-5 py-3 text-sm font-semibold text-slate-700 shadow-sm
                    backdrop-blur transition-colors duration-300 hover:bg-slate-50
                  "
                >
                  <Mail size={17} />
                  Email Doctor
                </motion.a>
              </motion.div>
            </div>
          </div>
        </motion.section>

        {/* =================================================
            STATS
        ================================================= */}
        <motion.section
          initial="hidden"
          whileInView="visible"
          viewport={{ once: true, amount: 0.15 }}
          variants={staggerContainer}
          className="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4"
        >
          <StatCard
            icon={<BriefcaseMedical size={21} />}
            value={`${doctorData.experience_years}+`}
            label="Years Experience"
            iconBg="bg-blue-100"
            iconColor="text-blue-600"
            cardBg="bg-blue-50/50"
          />
          <StatCard
            icon={<Stethoscope size={21} />}
            value={specializations.length}
            label="Specializations"
            iconBg="bg-cyan-100"
            iconColor="text-cyan-600"
            cardBg="bg-cyan-50/50"
          />
          <StatCard
            icon={<ShieldCheck size={21} />}
            value={certifications.length}
            label="Certifications"
            iconBg="bg-emerald-100"
            iconColor="text-emerald-600"
            cardBg="bg-emerald-50/50"
          />
          <StatCard
            icon={<Award size={21} />}
            value={awards.length}
            label="Awards"
            iconBg="bg-amber-100"
            iconColor="text-amber-600"
            cardBg="bg-amber-50/50"
          />
        </motion.section>

        {/* =================================================
            MAIN CONTENT
        ================================================= */}
        <section className="mt-6 grid gap-6 lg:grid-cols-[1fr_380px]">
          
          {/* LEFT CONTENT */}
          <motion.div
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true, amount: 0.08 }}
            variants={staggerContainer}
            className="space-y-6"
          >
            {/* ABOUT */}
            <Card glowColor="bg-blue-100">
              <SectionTitle
                icon={<BookOpen size={20} />}
                title="About Doctor"
                iconBg="bg-blue-50"
                iconColor="text-blue-600"
              />
              <p className="mt-5 text-[15px] leading-8 text-slate-600">
                {doctorData.web_bio}
              </p>
            </Card>

            {/* SPECIALIZATIONS */}
            {specializations.length > 0 && (
              <Card glowColor="bg-cyan-100">
                <SectionTitle
                  icon={<Stethoscope size={20} />}
                  title="Specializations"
                  iconBg="bg-cyan-50"
                  iconColor="text-cyan-600"
                />
                <motion.div variants={staggerContainer} className="mt-5 grid gap-3 sm:grid-cols-2">
                  {specializations.map((item, index) => (
                    <motion.div
                      key={index}
                      variants={fadeUp}
                      whileHover={{ x: 5 }}
                      className="
                        flex items-center gap-3 rounded-2xl border border-cyan-100
                        bg-cyan-50/50 p-4 transition-colors duration-300 hover:bg-cyan-50
                      "
                    >
                      <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-cyan-100 text-cyan-600">
                        <CheckCircle2 size={18} />
                      </div>
                      <span className="text-sm font-medium text-slate-700">{item}</span>
                    </motion.div>
                  ))}
                </motion.div>
              </Card>
            )}

            {/* CERTIFICATIONS */}
            {certifications.length > 0 && (
              <Card glowColor="bg-emerald-100">
                <SectionTitle
                  icon={<ShieldCheck size={20} />}
                  title="Certifications"
                  iconBg="bg-emerald-50"
                  iconColor="text-emerald-600"
                />
                <motion.div variants={staggerContainer} className="mt-5 space-y-3">
                  {certifications.map((certificate, index) => (
                    <motion.div
                      key={index}
                      variants={fadeUp}
                      whileHover={{ x: 5 }}
                      className="
                        flex flex-col gap-4 rounded-2xl border border-emerald-100
                        bg-emerald-50/40 p-5 transition-all duration-300 hover:bg-emerald-50/70
                        sm:flex-row sm:items-center sm:justify-between
                      "
                    >
                      <div className="flex gap-4">
                        <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-600">
                          <ShieldCheck size={21} />
                        </div>
                        <div>
                          <h3 className="font-semibold text-slate-800">{certificate.title}</h3>
                          <p className="mt-1 text-sm text-slate-500">{certificate.organization}</p>
                        </div>
                      </div>
                      <div className="flex items-center gap-2 text-sm font-semibold text-emerald-700">
                        <CalendarDays size={16} />
                        {certificate.year}
                      </div>
                    </motion.div>
                  ))}
                </motion.div>
              </Card>
            )}

            {/* AWARDS */}
            {awards.length > 0 && (
              <Card glowColor="bg-amber-100">
                <SectionTitle
                  icon={<Award size={20} />}
                  title="Awards & Recognition"
                  iconBg="bg-amber-50"
                  iconColor="text-amber-600"
                />
                <motion.div variants={staggerContainer} className="mt-5 grid gap-4 sm:grid-cols-2">
                  {awards.map((award, index) => (
                    <motion.div
                      key={index}
                      variants={fadeUp}
                      whileHover={{ y: -5 }}
                      className="
                        rounded-2xl border border-amber-100 bg-amber-50/40 p-5
                        transition-all duration-300 hover:bg-amber-50/70
                      "
                    >
                      <div className="flex items-start justify-between gap-4">
                        <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
                          <Award size={21} />
                        </div>
                        <span className="rounded-full bg-white px-3 py-1 text-xs font-bold text-amber-600 shadow-sm">
                          {award.year}
                        </span>
                      </div>
                      <h3 className="mt-4 font-semibold text-slate-800">{award.title}</h3>
                      <p className="mt-1 text-sm text-slate-500">{award.organization}</p>
                    </motion.div>
                  ))}
                </motion.div>
              </Card>
            )}
          </motion.div>

          {/* RIGHT SIDEBAR */}
          <motion.aside
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true, amount: 0.08 }}
            variants={staggerContainer}
            className="space-y-6"
          >
            {/* EXPERIENCE CARD */}
            <motion.div
              variants={fadeRight}
              whileHover={{ y: -5 }}
              className="
                group relative overflow-hidden rounded-[28px] bg-gradient-to-br
                from-[#063B5C] via-[#075579] to-[#0A7891] p-6 text-white
                shadow-[0_15px_40px_rgba(6,59,92,0.18)]
              "
            >
              <motion.div
                animate={{ scale: [1, 1.2, 1], opacity: [0.15, 0.25, 0.15] }}
                transition={{ duration: 5, repeat: Infinity, ease: "easeInOut" }}
                className="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-white/20 blur-3xl"
              />
              <motion.div
                animate={{ rotate: [0, 360] }}
                transition={{ duration: 18, repeat: Infinity, ease: "linear" }}
                className="absolute -right-12 bottom-[-40px] h-36 w-36 rounded-full border border-white/10"
              />
              <div className="relative">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 ring-1 ring-white/15">
                  <BriefcaseMedical size={23} />
                </div>
                <p className="mt-6 text-sm text-white/70">Professional Experience</p>
                <h2 className="mt-1 text-3xl font-bold">{doctorData.experience_years}+</h2>
                <p className="mt-1 text-sm text-white/80">Years of Medical Experience</p>
                <div className="mt-5 h-px bg-white/10" />
                <div className="mt-4 flex items-center gap-2 text-xs text-white/70">
                  <BadgeCheck size={15} />
                  Verified Professional
                </div>
              </div>
            </motion.div>

            {/* CONTACT INFORMATION */}
            <Card glowColor="bg-violet-100">
              <SectionTitle
                icon={<Phone size={20} />}
                title="Contact Information"
                iconBg="bg-violet-50"
                iconColor="text-violet-600"
              />
              <div className="mt-5 space-y-3">
                <motion.a
                  whileHover={{ x: 5 }}
                  href={`tel:${doctorData.contact_no}`}
                  className="
                    flex gap-3 rounded-2xl border border-violet-100 bg-violet-50/40
                    p-4 transition-colors duration-300 hover:bg-violet-50
                  "
                >
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-600">
                    <Phone size={18} />
                  </div>
                  <div>
                    <p className="text-xs font-medium text-slate-400">Phone</p>
                    <p className="mt-1 text-sm font-semibold text-slate-700">{doctorData.contact_no}</p>
                  </div>
                </motion.a>
                <motion.a
                  whileHover={{ x: 5 }}
                  href={`mailto:${doctorData.email}`}
                  className="
                    flex gap-3 rounded-2xl border border-violet-100 bg-violet-50/40
                    p-4 transition-colors duration-300 hover:bg-violet-50
                  "
                >
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-100 text-violet-600">
                    <Mail size={18} />
                  </div>
                  <div className="min-w-0">
                    <p className="text-xs font-medium text-slate-400">Email</p>
                    <p className="mt-1 truncate text-sm font-semibold text-slate-700">{doctorData.email}</p>
                  </div>
                </motion.a>
              </div>
            </Card>

            {/* QUALIFICATION */}
            <Card glowColor="bg-rose-100">
              <SectionTitle
                icon={<GraduationCap size={20} />}
                title="Qualification"
                iconBg="bg-rose-50"
                iconColor="text-rose-600"
              />
              <motion.div
                whileHover={{ scale: 1.01 }}
                className="mt-5 rounded-2xl border border-rose-100 bg-rose-50/40 p-5"
              >
                <div className="flex gap-3">
                  <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-600">
                    <GraduationCap size={19} />
                  </div>
                  <p className="text-sm leading-7 text-slate-600">{data.qualification}</p>
                </div>
              </motion.div>
            </Card>
          </motion.aside>
        </section>
      </div>
    </main>
  );
};

export default Page;